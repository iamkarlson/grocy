{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":enablePreCommit"
  ],
  "packageRules": [
    {
      "matchManagers": ["pep621"],
      "groupName": "python dependencies"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "manifest.json is what Home Assistant actually installs, so keep it in the same PR as pyproject.toml",
      "matchManagers": ["pep621", "custom.regex"],
      "matchPackageNames": ["grocy-py", "icalendar"],
      "groupName": "grocy integration requirements"
    },
    {
      "description": "Keep the ruff-pre-commit rev in step with the ruff pin in pyproject.toml; letting them drift is how a ruff bump turns into a surprise wall of findings",
      "matchManagers": ["pep621", "pre-commit"],
      "matchPackageNames": ["ruff", "astral-sh/ruff-pre-commit"],
      "groupName": "ruff"
    }
  ],
  "customManagers": [
    {
      "description": "Runtime requirements pinned in the Home Assistant manifest",
      "customType": "regex",
      "managerFilePatterns": ["/custom_components/.+/manifest\\.json$/"],
      "matchStrings": ["\"(?<depName>[a-zA-Z0-9_-]+)==(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "pypi"
    },
    {
      "description": "Minimum Home Assistant version advertised to HACS",
      "customType": "regex",
      "managerFilePatterns": ["/^hacs\\.json$/"],
      "matchStrings": ["\"homeassistant\"\\s*:\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "homeassistant",
      "datasourceTemplate": "pypi"
    }
  ]
}
